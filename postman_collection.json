{
  "info": {
    "name": "Root Backend Service (Mocks)",
    "description": "Collection for testing the mocked endpoints of the Root Backend Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Usuarios y Vibe Profile",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "me"]
            }
          }
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vibeProfile\": {\n    \"favoriteGenres\": [\"Hard Techno\"]\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:8080/v1/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "me"]
            }
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/users/2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "2"]
            }
          }
        }
      ]
    },
    {
