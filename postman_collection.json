      "item": [
        {
          "name": "Get Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/posts?filter=all",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "posts"],
              "query": [{"key": "filter", "value": "all"}]
