          }
        },
        {
          "name": "Like Post",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"like\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts/p1/like",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "posts", "p1", "like"]
            }
