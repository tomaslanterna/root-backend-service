            },
            "url": {
              "raw": "http://localhost:8080/v1/posts/p1/comments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "posts", "p1", "comments"]
            }
          }
        }
      ]
