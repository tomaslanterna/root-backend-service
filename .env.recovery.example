# Plantilla sin secretos: copiar valores completos al .env privado del backend.
# No activar una configuracion parcial: el backend valida todas las variables.
PASSWORD_RESET_EMAIL_PROVIDER=resend
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_EMAIL_FROM=
# Secreto aleatorio independiente, estable y de al menos 32 bytes.
PASSWORD_RESET_TOKEN_KEY=
# Desarrollo local. Produccion debe usar el origen HTTPS real del frontend.
FRONTEND_URL=http://localhost:3000
